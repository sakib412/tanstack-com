// The Site Database (Prisma Postgres). The client is generated by the build
// script (`prisma generate`) — the Build has no database — into
// src/generated/prisma, which is git-ignored.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "workerd"
}

datasource db {
  provider = "postgresql"
}

model Todo {
  id        Int      @id @default(autoincrement())
  title     String   @db.VarChar(200)
  done      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([createdAt])
  @@map("todos")
}

enum OrderStatus {
  pending
  paid
  shipped
  cancelled
}

/// Money is integer minor units (cents) — never floats.
model Product {
  id          Int         @id @default(autoincrement())
  slug        String      @unique @db.VarChar(120)
  name        String      @db.VarChar(200)
  description String      @default("")
  priceCents  Int         @map("price_cents")
  imageUrl    String?     @map("image_url") @db.VarChar(500)
  stock       Int         @default(0)
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  orderItems  OrderItem[]

  @@index([active, createdAt])
  @@map("products")
}

/// An order placed at checkout. `publicId` is the unguessable id in the
/// customer's confirmation link; `id` is never shown to visitors.
model Order {
  id           Int         @id @default(autoincrement())
  publicId     String      @unique @default(dbgenerated("gen_random_uuid()")) @map("public_id") @db.Uuid
  customerName String      @map("customer_name") @db.VarChar(120)
  phone        String?     @db.VarChar(40)
  addressLine1 String?     @map("address_line1") @db.VarChar(200)
  addressLine2 String?     @map("address_line2") @db.VarChar(200)
  city         String?     @db.VarChar(100)
  postalCode   String?     @map("postal_code") @db.VarChar(20)
  country      String?     @db.VarChar(80)
  note         String?     @db.VarChar(500)
  totalCents   Int         @map("total_cents")
  currency     String      @default("USD") @db.Char(3)
  status       OrderStatus @default(pending)
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")
  items        OrderItem[]

  /// DEPRECATED single-item columns from the first orders API. Null on
  /// checkout orders; drop them in a later migration once the owner approves.
  item           String? @db.VarChar(200)
  quantity       Int?
  unitPriceCents Int?    @map("unit_price_cents")

  @@index([createdAt])
  @@map("orders")
}

/// A line of an order. Name and price are copied at checkout so later
/// product edits never rewrite a past order.
model OrderItem {
  id             Int      @id @default(autoincrement())
  orderId        Int      @map("order_id")
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      Int?     @map("product_id")
  product        Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  name           String   @db.VarChar(200)
  unitPriceCents Int      @map("unit_price_cents")
  quantity       Int
  lineTotalCents Int      @map("line_total_cents")

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}
